.build/
build/
.swiftpm/
*.xcodeproj
xcuserdata/
.DS_Store
# RomRaider definitions have no explicit license; scripts/fetch-definitions.sh downloads them.
Sources/SSMKit/Resources/Definitions/*.xml

# The website and its deploy settings (server address, SSH key), kept local
/website/
/keys/

# Notes for AI assistants, kept local
CLAUDE.md
.claude/

# The Android app is not open source: it has a private repository of its own in this folder.
/android/

# Unmodified copies of other projects' source, kept local as reference for porting
/reference/

# Logs and page snapshots from browser automation, kept local
/.playwright-mcp/

# Microsoft's WebView2 SDK for the Windows build; scripts/fetch-webview2.ps1 downloads it.
/.webview2/

# The OpenPort USB-serial driver helper (libwdi); scripts/fetch-openport-driver.ps1 builds it.
/.openport-driver/

# Tactrix's EcuFlash installer, kept locally for reference only (proprietary, never commit it).
/ecuflash_*_win.exe
